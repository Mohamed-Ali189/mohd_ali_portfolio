---
import "../styles/global.css";
import CursorGlow from "../components/CursorGlow.astro";
import NetworkBg from "../components/NetworkBg.astro";
import ScanLines from "../components/ScanLines.astro";

export interface Props {
  title?: string;
  description?: string;
}

const { title = "Mohamed Ali Mohamud | Cyber-Portfolio", description = "Mohamed Ali Mohamud – Cybersecurity Specialist, Cloud Engineer, Fintech Founder, and Systems Architect." } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="author" content="Mohamed Ali Mohamud" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Orbitron:wght@500;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <NetworkBg />
    <CursorGlow />
    <ScanLines />
    <div class="grid-bg" aria-hidden="true"></div>
    <slot />
    <script>
      import { inView, animate } from "motion";

      const animVariants = [
        { opacity: [0, 1], transform: ["translateY(30px) scale(0.97)", "translateY(0) scale(1)"] },
        { opacity: [0, 1], transform: ["translateY(-20px)", "translateY(0)"] },
        { opacity: [0, 1], transform: ["translateX(-30px)", "translateX(0)"] },
        { opacity: [0, 1], transform: ["translateX(30px)", "translateX(0)"] },
        { opacity: [0, 1], transform: ["scale(0.85) translateY(10px)", "scale(1) translateY(0)"] },
        { opacity: [0, 1], transform: ["translateY(20px) rotateX(6deg)", "translateY(0) rotateX(0)"] },
      ];

      function pickRandom(arr) {
        return arr[Math.floor(Math.random() * arr.length)];
      }

      function setupAnimations() {
        // Reveal single elements with keyframe animation
        document.querySelectorAll(".reveal").forEach((el) => {
          inView(
            el,
            () => {
              animate(
                el,
                { opacity: [0, 1], transform: ["translateY(30px) scale(0.97)", "translateY(0) scale(1)"] },
                { duration: 0.8, easing: [0.22, 1, 0.36, 1] }
              );
            },
            { amount: 0.15 }
          );
        });

        // Stagger card grids — each card gets a random variant + random delay
        document.querySelectorAll(".stagger-grid").forEach((grid) => {
          const cards = Array.from(grid.querySelectorAll(".stagger-card"));
          inView(
            grid,
            () => {
              cards.forEach((card, i) => {
                const variant = pickRandom(animVariants);
                animate(
                  card,
                  variant,
                  {
                    duration: 0.5 + Math.random() * 0.3,
                    easing: [0.22, 1, 0.36, 1],
                    delay: i * 0.04 + Math.random() * 0.15,
                  }
                );
              });
            },
            { amount: 0.1 }
          );
        });

        // Timeline items — random variant per item
        document.querySelectorAll(".stagger-timeline").forEach((tl) => {
          const items = Array.from(tl.querySelectorAll(".timeline-item"));
          inView(
            tl,
            () => {
              items.forEach((item, i) => {
                const variant = pickRandom(animVariants);
                animate(
                  item,
                  variant,
                  {
                    duration: 0.5 + Math.random() * 0.3,
                    easing: [0.22, 1, 0.36, 1],
                    delay: i * 0.08 + Math.random() * 0.12,
                  }
                );
              });
            },
            { amount: 0.1 }
          );
        });
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", setupAnimations);
      } else {
        setupAnimations();
      }
      document.addEventListener("astro:page-load", setupAnimations);
    </script>
  </body>
</html>

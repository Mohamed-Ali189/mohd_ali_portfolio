<canvas id="cursor-canvas" aria-hidden="true" class="pointer-events-none fixed inset-0 z-50" style="mix-blend-mode: screen;"></canvas>

<script>
  const canvas = document.getElementById("cursor-canvas") as HTMLCanvasElement;
  const ctx = canvas!.getContext("2d")!;
  let w: number, h: number;
  let mouseX = -200, mouseY = -200;
  const particles: { x: number; y: number; vx: number; vy: number; alpha: number }[] = [];

  function resize() {
    w = canvas!.width = window.innerWidth;
    h = canvas!.height = window.innerHeight;
  }
  resize();
  window.addEventListener("resize", resize);

  document.addEventListener("mousemove", (e) => {
    mouseX = e.clientX;
    mouseY = e.clientY;
  });

  function draw() {
    ctx!.clearRect(0, 0, w, h);

    // Main glow
    const gradient = ctx!.createRadialGradient(mouseX, mouseY, 0, mouseX, mouseY, 200);
    gradient.addColorStop(0, "rgba(0, 210, 255, 0.06)");
    gradient.addColorStop(0.5, "rgba(0, 210, 255, 0.02)");
    gradient.addColorStop(1, "transparent");
    ctx!.fillStyle = gradient;
    ctx!.fillRect(0, 0, w, h);

    // Particles
    if (Math.random() > 0.7) {
      particles.push({
        x: mouseX + (Math.random() - 0.5) * 60,
        y: mouseY + (Math.random() - 0.5) * 60,
        vx: (Math.random() - 0.5) * 0.5,
        vy: (Math.random() - 0.5) * 0.5 - 0.3,
        alpha: 0.6,
      });
    }

    for (let i = particles.length - 1; i >= 0; i--) {
      const p = particles[i];
      p.x += p.vx;
      p.y += p.vy;
      p.alpha -= 0.008;
      if (p.alpha <= 0) { particles.splice(i, 1); continue; }
      ctx!.beginPath();
      ctx!.arc(p.x, p.y, 1.5, 0, Math.PI * 2);
      ctx!.fillStyle = `rgba(0, 210, 255, ${p.alpha})`;
      ctx!.fill();
    }

    requestAnimationFrame(draw);
  }
  draw();
</script>

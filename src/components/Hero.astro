<section class="section-container pt-24 md:pt-32" id="hero" aria-labelledby="hero-title">
  <div class="grid md:grid-cols-[3fr_2fr] gap-8 md:gap-12 items-center">
    <div class="text-center md:text-left">
      <p class="tag-pill mx-auto md:mx-0 w-fit mb-4 reveal">
        <span id="hero-tagline"></span>
        <span class="inline-block w-[2px] h-[1em] bg-primary animate-pulse ml-0.5" id="tagline-cursor"></span>
      </p>

      <h1 id="hero-title" class="font-display text-[clamp(2rem,1.5rem+2.5vw,3.5rem)] leading-[1.1] tracking-[0.02em] mb-2 reveal">
        Mohamed Ali <span class="text-primary">Mohamud</span>
      </h1>

      <p class="text-muted text-lg leading-relaxed max-w-[500px] mb-6 mx-auto md:mx-0 reveal" id="hero-sub">
        <span id="hero-sub-text"></span><span class="inline-block w-[2px] h-[1.1em] bg-primary/70 animate-pulse ml-0.5" id="sub-cursor"></span>
      </p>

      <div class="flex gap-3 justify-center md:justify-start mb-6 reveal">
        <a href="#experience" class="btn-primary relative overflow-hidden group">
          <span class="relative z-10">View Ventures</span>
          <span class="absolute inset-0 bg-white/10 translate-y-full group-hover:translate-y-0 transition-transform duration-500"></span>
        </a>
        <a href="#contact" class="btn-ghost relative overflow-hidden group">
          <span class="relative z-10">Open Terminal</span>
          <span class="absolute inset-0 bg-primary/5 translate-y-full group-hover:translate-y-0 transition-transform duration-500"></span>
        </a>
      </div>

      <div class="flex items-center justify-center md:justify-start gap-3 mb-5 reveal">
        <span class="status-dot"></span>
        <span class="font-display text-[0.7rem] tracking-[0.1em] uppercase text-primary font-semibold">Status: Secure System Online</span>
      </div>

      <div class="flex gap-4 justify-center md:justify-start text-[0.75rem] text-muted font-semibold uppercase tracking-[0.05em] reveal">
        <span class="flex items-center gap-1.5"><span class="text-primary">◆</span> Hyderabad, India</span>
        <span class="flex items-center gap-1.5"><span class="text-primary">◆</span> 3+ Years IT Exp</span>
      </div>
    </div>

    <div class="relative flex items-center justify-center reveal" aria-hidden="true">
      <div class="hero-grid-3d"></div>
      <div class="relative z-10 cyber-shield">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
          class="w-40 h-40 md:w-48 md:h-48 text-primary shield-icon">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        </svg>
        <div class="shield-ring ring-1"></div>
        <div class="shield-ring ring-2"></div>
        <div class="shield-ring ring-3"></div>
      </div>
    </div>
  </div>
</section>

<script>
  // Typewriter for tagline
  const tagline = "Cybersecurity Specialist | Cloud Engineer | Fintech Founder";
  const taglineEl = document.getElementById("hero-tagline");
  const taglineCursor = document.getElementById("tagline-cursor");
  let tagIndex = 0;

  function typeTagline() {
    if (tagIndex < tagline.length) {
      taglineEl!.textContent += tagline[tagIndex];
      tagIndex++;
      setTimeout(typeTagline, 25 + Math.random() * 25);
    } else {
      taglineCursor!.classList.add("animate-pulse");
      // Start subtitle typewriter
      const subText = "Systems Architect and Emerging Market Innovator.";
      const subEl = document.getElementById("hero-sub-text");
      const subCursor = document.getElementById("sub-cursor");
      let subIndex = 0;
      function typeSub() {
        if (subIndex < subText.length) {
          subEl!.textContent += subText[subIndex];
          subIndex++;
          setTimeout(typeSub, 20 + Math.random() * 30);
        } else {
          subCursor!.classList.add("animate-pulse");
        }
      }
      setTimeout(typeSub, 400);
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => setTimeout(typeTagline, 500));
  } else {
    setTimeout(typeTagline, 500);
  }
</script>

<style>
  .cyber-shield {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .shield-icon {
    animation: float 6s ease-in-out infinite;
    filter: drop-shadow(0 0 30px oklch(0.72 0.16 220 / 0.4));
    position: relative;
    z-index: 2;
  }

  .shield-ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid oklch(0.72 0.16 220 / 0.15);
    animation: ringPulse 4s ease-out infinite;
    pointer-events: none;
  }

  .ring-1 { width: 200px; height: 200px; }
  .ring-2 { width: 260px; height: 260px; animation-delay: 0.8s; }
  .ring-3 { width: 320px; height: 320px; animation-delay: 1.6s; }

  @keyframes ringPulse {
    0% { transform: scale(0.8); opacity: 1; border-color: oklch(0.72 0.16 220 / 0.25); }
    100% { transform: scale(1.5); opacity: 0; border-color: oklch(0.72 0.16 220 / 0); }
  }

  @keyframes float {
    0%, 100% { transform: translateY(0) rotate(0deg); filter: drop-shadow(0 0 30px oklch(0.72 0.16 220 / 0.4)); }
    50% { transform: translateY(-12px) rotate(2deg); filter: drop-shadow(0 0 50px oklch(0.72 0.16 220 / 0.6)); }
  }

  .hero-grid-3d {
    position: absolute;
    inset: -50%;
    opacity: 0.04;
    background-image:
      linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
    background-size: 40px 40px;
    transform: perspective(500px) rotateX(60deg) translateY(-80px);
    animation: gridScroll 20s linear infinite;
  }

  @keyframes gridScroll {
    0% { transform: perspective(500px) rotateX(60deg) translateY(-80px); }
    100% { transform: perspective(500px) rotateX(60deg) translateY(40px); }
  }
</style>

<section class="section-container" id="about" aria-labelledby="about-title">
  <div class="section-card p-6 md:p-10 reveal">
    <div class="grid md:grid-cols-[320px_1fr] gap-8 items-center">
      <div class="relative mx-auto w-full max-w-[320px] rounded-[var(--radius-card)] overflow-hidden border border-border aspect-[3/4]">
        <img src={import.meta.env.BASE_URL + "assets/mohamed_ali_new_3.jpg"} alt="Mohamed Ali Mohamud" class="w-full h-full object-cover object-top transition-transform duration-700 hover:scale-105" />
        <div class="absolute inset-0 pointer-events-none" style="background: linear-gradient(135deg, oklch(0.72 0.16 220 / 0.15), transparent 60%);"></div>
      </div>

      <div class="text-center md:text-left">
        <h2 class="section-title" id="about-title">Professional Summary</h2>
        <p class="text-muted text-base leading-relaxed mb-4">
          <strong class="text-text">Mohamed Ali Mohamud</strong> is a technology entrepreneur and cybersecurity specialist
          focused on designing secure digital infrastructure for emerging markets.
        </p>
        <p class="text-muted text-base leading-relaxed mb-4">
          With expertise in cloud computing (AWS), Linux system administration, cybersecurity
          architecture, and fintech systems, he builds technology-driven solutions that address real-world
